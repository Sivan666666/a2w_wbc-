+    env.close()
+    save('status.json', dict(stage='COMPLETE', seed=a.seed, steps=total))
+
+
+try:
+    main()
+except BaseException:
+    save('status.json', dict(stage='FAILED', traceback=traceback.format_exc()))
+    raise
+finally:
+    app.close()
